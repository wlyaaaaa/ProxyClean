<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProxyClean · 维护工具" Width="820" Height="690" MinWidth="580" MinHeight="400" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#203A2C" UseLayoutRounding="True"><Window.Resources>
 <Style TargetType="Button">
  <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24633F"/><Setter Property="BorderBrush" Value="#C8DECF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#103E25"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#17834A"/><Setter Property="BorderBrush" Value="#17834A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="172"/><Setter Property="Padding" Value="24,12"/></Style>
 <Style TargetType="Expander"><Setter Property="Margin" Value="0,10,0,6"/><Setter Property="Padding" Value="0,5"/></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CCDCD1"/><Setter Property="Foreground" Value="#334D3E"/></Style>
</Window.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16"><TextBlock Text="日常只用首页即可；这里保留手动维护功能。" Foreground="#718277" TextWrapping="Wrap" Margin="0,0,0,8"/><Expander x:Name="AdvancedExpander" Header="维护工具" IsExpanded="True"><StackPanel x:Name="AdvancedBody" Margin="18,12,0,0">
<TextBlock Text="以下不是日常修复的必选步骤。执行前会说明影响。" TextWrapping="Wrap" Foreground="#718277" Margin="0,0,0,18"/>
<TextBlock Text="代理设置" FontWeight="SemiBold" Margin="0,0,0,10"/>
<WrapPanel><Button x:Name="DirectButton" Content="关闭手动代理…"/><Button x:Name="ConnectivityButton" Content="检查联网情况"/><Button x:Name="ExitButton" Content="比较联网出口…"/></WrapPanel>
<TextBlock Text="结束占用端口的程序" FontWeight="SemiBold" Margin="0,14,0,10"/>
<TextBlock Text="选择已识别的程序，或手动输入端口。先查看范围，不会直接结束。" Foreground="#718277" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
<WrapPanel><ComboBox x:Name="ClientCombo" Width="275" DisplayMemberPath="label"/><TextBox x:Name="PortInput" Width="95" Height="36" Margin="0,0,10,10" ToolTip="端口：1 到 65535"/><Button x:Name="StopPreviewButton" Content="查看结束范围"/></WrapPanel>
<TextBlock Text="网卡与连接" FontWeight="SemiBold" Margin="0,14,0,10"/>
<ComboBox x:Name="AdapterCombo" DisplayMemberPath="label" HorizontalAlignment="Left" MinWidth="275"/>
<WrapPanel><Button x:Name="WifiSoftButton" Content="刷新连接…"/><Button x:Name="WifiResetButton" Content="重启网卡…"/><Button x:Name="DnsButton" Content="刷新域名缓存…"/></WrapPanel>
<WrapPanel><Button x:Name="IPv6StatusButton" Content="查看 IPv6 状态"/><Button x:Name="IPv6EnableButton" Content="启用 IPv6…"/><Button x:Name="IPv6DisableButton" Content="禁用 IPv6…"/></WrapPanel>
<TextBlock Text="网卡操作可能中断当前网络，不属于代理设置的恢复范围。" TextWrapping="Wrap" FontSize="12" Foreground="#718277" Margin="0,4,0,12"/>
</StackPanel></Expander></StackPanel></ScrollViewer></Window>