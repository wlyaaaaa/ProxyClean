<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProxyClean · 代理检查与修复" Width="900" Height="780" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterScreen" Background="White" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#203A2C" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="Button">
  <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24633F"/><Setter Property="BorderBrush" Value="#C8DECF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#103E25"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#17834A"/><Setter Property="BorderBrush" Value="#17834A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="172"/><Setter Property="Padding" Value="24,12"/></Style>
 <Style TargetType="Expander"><Setter Property="Margin" Value="0,10,0,6"/><Setter Property="Padding" Value="0,5"/></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CCDCD1"/><Setter Property="Foreground" Value="#334D3E"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,24,30,20">
<Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ProxyClean" FontSize="27" FontWeight="SemiBold" Foreground="#167844"/><TextBlock Text="代理检查与修复" Foreground="#718277" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#F0F8F3" CornerRadius="12" Padding="12,6" VerticalAlignment="Top"><TextBlock x:Name="ModeBadge" Text="本机检查" FontSize="12" Foreground="#286B44"/></Border></Grid>
<Border x:Name="Hero" Background="#F1FAF5" BorderBrush="#D5EBDD" BorderThickness="1" CornerRadius="16" Padding="26,22,26,16"><StackPanel>
<TextBlock x:Name="Eyebrow" Text="先检查，再决定" FontSize="12" FontWeight="SemiBold" Foreground="#258A50" Margin="0,0,0,10"/>
<TextBlock x:Name="Headline" Text="正在检查代理设置" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock x:Name="Explanation" Text="正在读取本机状态，不会自动修改网络。" TextWrapping="Wrap" LineHeight="25" Foreground="#556D5E" Margin="0,12,0,14"/>
<ItemsControl x:Name="ActionItems" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="7" Padding="12,9" Margin="0,0,0,6"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#2A6541"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel><Button x:Name="Primary" Content="正在检查…" Style="{StaticResource PrimaryButton}" IsEnabled="False"/><Button x:Name="Recheck" Content="重新检查" Visibility="Collapsed"/><Button x:Name="UndoButton" Content="恢复上次修改" Visibility="Collapsed"/><Button x:Name="CancelButton" Content="取消检查" Visibility="Collapsed"/></WrapPanel>
<ProgressBar x:Name="Progress" Height="4" Foreground="#249D5B" Background="#DCEEE2" IsIndeterminate="True" Margin="0,8,0,12"/>
<TextBlock x:Name="CurrentStage" Text="正在准备检查…" FontSize="12" Foreground="#607B6B" TextWrapping="Wrap"/>
</StackPanel></Border>
<Expander x:Name="ProcessExpander" Header="本次过程（最新在上）" IsExpanded="True" Margin="0,18,0,0"><ListBox x:Name="ProcessLog" MaxHeight="144" BorderThickness="0" Background="White" Foreground="#546F60" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,0" IsTabStop="False"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
<Border Height="1" Background="#E7EFE9" Margin="0,16,0,6"/>
<Expander x:Name="DetailsExpander" Header="查看检查详情"><StackPanel Margin="18,10,0,0"><TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="280" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FBF9" Text="完成检查后，这里会显示各项中文结果。"/><Button x:Name="CopyButton" Content="复制脱敏诊断" HorizontalAlignment="Left" Margin="0,12,0,4" IsEnabled="False"/><TextBlock Text="用于排查问题，不包含代理密码、原始公网 IP 或设置备份。" FontSize="12" Foreground="#718277" TextWrapping="Wrap" Margin="0,2,0,4"/></StackPanel></Expander>
<Expander x:Name="AdvancedExpander" Header="更多操作"><StackPanel x:Name="AdvancedBody" Margin="18,12,0,0">
<TextBlock Text="以下不是日常修复的必选步骤。执行前会说明影响。" TextWrapping="Wrap" Foreground="#718277" Margin="0,0,0,18"/>
<TextBlock Text="代理设置" FontWeight="SemiBold" Margin="0,0,0,10"/>
<WrapPanel><Button x:Name="DirectButton" Content="关闭手动代理…"/><Button x:Name="ConnectivityButton" Content="检查联网情况"/><Button x:Name="ExitButton" Content="比较联网出口…"/></WrapPanel>
<TextBlock Text="结束占用端口的程序" FontWeight="SemiBold" Margin="0,14,0,10"/>
<TextBlock Text="选择已识别的程序，或手动输入端口。先查看范围，不会直接结束。" Foreground="#718277" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
<WrapPanel><ComboBox x:Name="ClientCombo" Width="275" DisplayMemberPath="label"/><TextBox x:Name="PortInput" Width="95" Height="36" Margin="0,0,10,10" ToolTip="端口：1 到 65535"/><Button x:Name="StopPreviewButton" Content="查看结束范围"/></WrapPanel>
<TextBlock Text="网卡与连接" FontWeight="SemiBold" Margin="0,14,0,10"/>
<ComboBox x:Name="AdapterCombo" DisplayMemberPath="label" HorizontalAlignment="Left" MinWidth="275"/>
<WrapPanel><Button x:Name="WifiSoftButton" Content="刷新连接…"/><Button x:Name="WifiResetButton" Content="重启网卡…"/><Button x:Name="DnsButton" Content="刷新域名缓存…"/></WrapPanel>
<WrapPanel><Button x:Name="IPv6StatusButton" Content="查看 IPv6 状态"/><Button x:Name="IPv6EnableButton" Content="启用 IPv6…"/><Button x:Name="IPv6DisableButton" Content="禁用 IPv6…"/></WrapPanel>
<TextBlock Text="网卡操作可能中断当前网络，不属于代理设置的恢复范围。" TextWrapping="Wrap" FontSize="12" Foreground="#718277" Margin="0,4,0,12"/>
</StackPanel></Expander>
</StackPanel></ScrollViewer>
<Border Grid.Row="1" BorderBrush="#E7EFE9" BorderThickness="0,1,0,0" Padding="30,12" Background="White"><TextBlock Text="确认后才修改设置  ·  不安装常驻服务" FontSize="12" Foreground="#819187"/></Border>
</Grid></Window>
