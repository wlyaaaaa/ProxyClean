<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProxyClean · 代理检查与修复" Width="740" Height="590" MinWidth="580" MinHeight="440" WindowStartupLocation="CenterScreen" Background="White" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#203A2C" UseLayoutRounding="True"><Window.Resources>
 <Style TargetType="Button">
  <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24633F"/><Setter Property="BorderBrush" Value="#C8DECF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#103E25"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#17834A"/><Setter Property="BorderBrush" Value="#17834A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="172"/><Setter Property="Padding" Value="24,12"/></Style>
 <Style TargetType="Expander"><Setter Property="Margin" Value="0,10,0,6"/><Setter Property="Padding" Value="0,5"/></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CCDCD1"/><Setter Property="Foreground" Value="#334D3E"/></Style>
</Window.Resources><Grid Margin="30,24,30,16">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="ProxyClean" FontSize="27" FontWeight="SemiBold" Foreground="#167844"/><TextBlock Text="代理检查与修复" Foreground="#718277" Margin="0,4,0,0"/></StackPanel>
  <TextBlock x:Name="ModeBadge" Text="本机检查" Grid.Column="1" FontSize="12" Foreground="#718277" VerticalAlignment="Center"/>
 </Grid>
 <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Border x:Name="Hero" Background="#F1FAF5" BorderBrush="#D5EBDD" BorderThickness="1" CornerRadius="16" Padding="26,24" VerticalAlignment="Top">
   <StackPanel>
    <TextBlock x:Name="Eyebrow" Text="当前状态" FontSize="12" Foreground="#258A50" Margin="0,0,0,12"/>
    <TextBlock x:Name="Headline" Text="正在检查代理设置" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="Explanation" Text="只读取状态，不会自动修改网络。" TextWrapping="Wrap" LineHeight="25" Foreground="#556D5E" Margin="0,12,0,20"/>
    <ItemsControl x:Name="ActionItems" Margin="0,0,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#2A6541" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel x:Name="ClientPickerPanel" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="要关闭哪个代理？其他代理会保留。" Margin="0,0,0,8"/><ComboBox x:Name="DisconnectClients" DisplayMemberPath="label" MinWidth="240" HorizontalAlignment="Left"/></StackPanel>
    <Button x:Name="Primary" Content="正在检查…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="280" IsEnabled="False"/>
    <Button x:Name="DisconnectButton" Content="关闭代理，恢复普通上网" ToolTip="一次点击：正常退出，超时自动处理残留，保留辅助服务的再次启动能力。必要时仅需 Windows 授权。" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,8" Margin="0,2,0,0" Visibility="Collapsed"/>
    <WrapPanel><Button x:Name="UndoButton" Content="恢复上次修改" Background="Transparent" BorderThickness="0" Padding="0,6" Visibility="Collapsed"/><Button x:Name="CancelButton" Content="取消检查" Background="Transparent" BorderThickness="0" Padding="0,6" Visibility="Collapsed"/></WrapPanel>
    <ProgressBar x:Name="Progress" Height="4" Foreground="#249D5B" Background="#DCEEE2" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,10"/>
    <TextBlock x:Name="CurrentStage" Text="正在准备检查…" FontSize="12" Foreground="#607B6B" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
 </ScrollViewer>
 <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Button x:Name="HomeButton" Content="返回首页" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,4" Margin="0" Visibility="Collapsed"/>
  <WrapPanel Grid.Column="1"><Button x:Name="ViewDetailsButton" Content="查看详情" Background="Transparent" BorderThickness="0" Padding="6,4" FontSize="12" Foreground="#718277" Margin="0,0,10,0"/><Button x:Name="MaintenanceButton" Content="维护工具" Background="Transparent" BorderThickness="0" Padding="6,4" FontSize="12" Foreground="#718277" Margin="0"/></WrapPanel>
 </Grid>
</Grid></Window>